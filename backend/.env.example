# VigilAI configuration — worldwide-first. ALL keys are OPTIONAL.
# The app runs fully offline with zero API keys; every capability below has a
# deterministic fallback. Copy this file to `.env` and fill in what you want.

# Database (default: local SQLite file)
DATABASE_URL=sqlite:///./vigilai.db

# ---- Optional live data sources (seed + Reddit RSS need NO key) ----
# Twitter/X live crawl needs a key (twitterapi.io):
TWITTERAPI_IO_KEY=
# YouTube Data API v3 — get free key at console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=
# Firecrawl for real agentic forum onboarding (heuristic fallback otherwise):
FIRECRAWL_API_KEY=
# Optional Slack/Teams/custom webhook for outbound PV alert push (empty = simulated):
ALERT_WEBHOOK_URL=

# ---- Optional LLM for narratives + Forge (local Ollama = no cloud key) ----
# Install Ollama and `ollama pull llama3.2:3b`. VigilAI auto-detects the daemon.
USE_LLM=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Or cloud (optional — used when Ollama is offline / unavailable):
# Free key: https://aistudio.google.com/apikey  → paste below → restart backend
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback chain: Ollama (local) → Gemini → OpenRouter → deterministic templates
# Forge, narratives, and Copilot all use this same chain.

# ---- openFDA (US FAERS) evidence — NO key required; key only raises rate limits ----
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov

# ---- NCBI/PubMed — NO key required; key raises rate limit to 10 req/sec ----
# Get free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ---- Worldwide terminology services (NO key) ----
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
# WHO ICD-11 enrichment is optional and requires free API credentials:
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# ---- Worldwide NLP feature flags (default ON; each falls back offline) ----
USE_TRANSFORMER_NER=true
TRANSFORMER_NER_MODEL=d4data/biomedical-ner-all
USE_PRESIDIO=true
USE_RXNORM=true
USE_ONLINE_TRANSLATION=true

# ---- Auth ----
JWT_SECRET=vigilai-dev-secret-change-me
JWT_EXPIRE_MINUTES=720
SEED_ADMIN_EMAIL=admin@vigilai.dev
SEED_ADMIN_PASSWORD=admin123

# ---- Agentic discovery pipeline (optional; offline fallbacks) ----
# Self-hosted SearXNG (preferred Pathfinder search — docker-compose service)
SEARXNG_BASE_URL=http://127.0.0.1:8080
# Optional self-hosted Firecrawl for JS-heavy DOM screening
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=
# Exa AI semantic search — https://exa.ai
EXA_API_KEY=
# Tavily AI search — https://tavily.com
TAVILY_API_KEY=
# Playwright authenticated session (login-walled forums). Run once manually:
#   playwright codegen --save-storage=backend/app/browser_profiles/cookies.json <forum-url>
# Spec vault alias: project_vault/cookies.json
PLAYWRIGHT_STORAGE_STATE_PATH=
# Optional STITCH/STRING-compatible enrichment base (offline KB always used)
STITCH_CHEM_API_BASE=https://string-db.org/api

FORGE_QUALITY_THRESHOLD=80
FORGE_MAX_REPAIR_ATTEMPTS=1
